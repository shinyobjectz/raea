// The hook with the tree visible: a block after an element holds its children.
import EndCard "./EndCard.tsx"

edit  :: Edit{fps = 30, size = {1080, 1920}, frames = 150}
words :: bind("words")

bg :: box{w = 1080, h = 1920, bg = "linear-gradient(180deg, #1b1f3a, #3a1b2f)"} {
    hook :: title{"Stop scrolling", span = 0..<90, y = ease(.out, {0 = 760, 14 = 620}), opacity = {0 = 0, 10 = 1}}
    sub  :: text{"this changes your mornings", span = 12..<90, y = 820, color = "#ffcc66",
                 scale = spring(0.6, 1, at = 0, stiffness = 180, damping = 12)}
    caps :: captions{words = words}
    end  :: EndCard{from = 96, y = 760, title = "Shop the kit"}
}
