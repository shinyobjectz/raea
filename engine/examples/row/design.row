// A 9:16 promo designed in plain Odin: design tokens are Style bundles, a stack lays the page out
// (flexbox), and motion is curves and springs on the same props.
edit :: Edit{fps = 30, size = {1080, 1920}, frames = 120}

// tokens
display :: Style{font = "Avenir Next", weight = 800, size = 132, line = 0.95, tracking = -3, color = "#fff8ec"}
kicker  :: Style{font = "Avenir Next", weight = 700, size = 32, tracking = 6, case = "uppercase", color = "#ffd8c2"}
body    :: Style{font = "Avenir Next", weight = 500, size = 44, line = 1.3, color = "#2a2440"}
card    :: Style{bg = "#fff8ec", radius = 48, padding = 64, gap = 24, shadow = "0 40px 90px rgba(20, 10, 60, 0.45)"}
pill    :: Style{bg = "#14121f", color = "#fff8ec", radius = 999, padding = 28, size = 40, weight = 700, align = "center"}

bg :: box{w = 1080, h = 1920, bg = "radial-gradient(circle at 25% 15%, #ff7a59 0%, #c2369b 45%, #3b1c8c 100%)"}

page :: stack{in = bg, gap = 48, padding = 96, justify = "center", items = "stretch"} {
    tag  :: text{"New · Spring drop", style = kicker, align = "left"}
    head :: title{"Mornings, but softer.", style = display, align = "left"}
    box1 :: stack{style = card, from = 18} {
        line1 :: text{"A 5-minute ritual that actually sticks: one serum, one step, no guesswork.", style = body, align = "left"}
        cta   :: text{"Shop the kit →", style = pill, from = 30}
    }
}

head.opacity = ease(.out, {0 = 0, 14 = 1})
head.y       = ease(.out, {0 = 60, 18 = 0})
tag.opacity  = {0 = 0, 8 = 1}
box1.y       = spring(240, 0, stiffness = 140, damping = 16)
box1.opacity = {0 = 0, 6 = 1}
cta.scale    = spring(0.7, 1, stiffness = 220, damping = 11)
