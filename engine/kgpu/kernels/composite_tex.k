/ composite.k with each clip's NV12 planes as textures (Y0..Y3 R8 luma, U0..U3 RG8 chroma), as VideoToolbox's
/ buffers wrap without a copy; the camera's target T, the clip parameters C and the overlay O as in composite.k.
/ The same arithmetic, so the same pixels as composite.k on the same planes.
/ Luma and chroma are bilinear; YUV is BT.709 limited range in 8.8 fixed point. One RGBA word per pixel.
x:i!w
y:i%w
bg:tex[T;x;y]
r:and[bg;255]
g:and[shr[bg;8];255]
b:and[shr[bg;16];255]
/ clip slot 0
on0:word[C;0]
bx0:word[C;1]
by0:word[C;2]
ex0:word[C;3]
ey0:word[C;4]
sw0:word[C;5]
sh0:word[C;6]
cx0:word[C;7]
cy0:word[C;8]
dx0:word[C;9]
dy0:word[C;10]
al0:word[C;11]
in0:on0*(x>bx0-1)*(x<ex0)*(y>by0-1)*(y<ey0)
ms0:on0>1
cov0:(ms0*and[shr[word[M;i];0];255])+((1-ms0)*255)
am0:((al0*cov0)+127)%255
when in0
fx0:cx0+((x-bx0)*dx0)+(shr[dx0;1])-32768
fy0:cy0+((y-by0)*dy0)+(shr[dy0;1])-32768
ax0:clamp[shr[fx0;16];0;sw0-2]
ay0:clamp[shr[fy0;16];0;sh0-2]
wx0:clamp[and[shr[fx0;8];255]*(fx0>0-1);0;255]
wy0:clamp[and[shr[fy0;8];255]*(fy0>0-1);0;255]
y000:and[tex[Y0;ax0;ay0];255]
y100:and[tex[Y0;ax0+1;ay0];255]
y010:and[tex[Y0;ax0;ay0+1];255]
y110:and[tex[Y0;ax0+1;ay0+1];255]
ly0:shr[(y000*(256-wx0)*(256-wy0))+(y100*wx0*(256-wy0))+(y010*(256-wx0)*wy0)+(y110*wx0*wy0)+32768;16]
gx0:(shr[fx0+32768;1])-32768
gy0:(shr[fy0+32768;1])-32768
qx0:clamp[shr[gx0;16];0;(sw0%2)-2]
qy0:clamp[shr[gy0;16];0;(sh0%2)-2]
vx0:clamp[and[shr[gx0;8];255]*(gx0>0-1);0;255]
vy0:clamp[and[shr[gy0;8];255]*(gy0>0-1);0;255]
u000:and[tex[U0;qx0;qy0];255]
u100:and[tex[U0;qx0+1;qy0];255]
u010:and[tex[U0;qx0;qy0+1];255]
u110:and[tex[U0;qx0+1;qy0+1];255]
v000:and[shr[tex[U0;qx0;qy0];8];255]
v100:and[shr[tex[U0;qx0+1;qy0];8];255]
v010:and[shr[tex[U0;qx0;qy0+1];8];255]
v110:and[shr[tex[U0;qx0+1;qy0+1];8];255]
cu0:(shr[(u000*(256-vx0)*(256-vy0))+(u100*vx0*(256-vy0))+(u010*(256-vx0)*vy0)+(u110*vx0*vy0)+32768;16])-128
cv0:(shr[(v000*(256-vx0)*(256-vy0))+(v100*vx0*(256-vy0))+(v010*(256-vx0)*vy0)+(v110*vx0*vy0)+32768;16])-128
k0:298*ly0-16
rr0:clamp[shr[k0+(459*cv0)+128;8];0;255]
gg0:clamp[shr[k0-(55*cu0)+(136*cv0)-128;8];0;255]
bb0:clamp[shr[k0+(541*cu0)+128;8];0;255]
r:shr[(am0*rr0)+((256-am0)*r);8]
g:shr[(am0*gg0)+((256-am0)*g);8]
b:shr[(am0*bb0)+((256-am0)*b);8]
end
/ clip slot 1
on1:word[C;12]
bx1:word[C;13]
by1:word[C;14]
ex1:word[C;15]
ey1:word[C;16]
sw1:word[C;17]
sh1:word[C;18]
cx1:word[C;19]
cy1:word[C;20]
dx1:word[C;21]
dy1:word[C;22]
al1:word[C;23]
in1:on1*(x>bx1-1)*(x<ex1)*(y>by1-1)*(y<ey1)
ms1:on1>1
cov1:(ms1*and[shr[word[M;i];8];255])+((1-ms1)*255)
am1:((al1*cov1)+127)%255
when in1
fx1:cx1+((x-bx1)*dx1)+(shr[dx1;1])-32768
fy1:cy1+((y-by1)*dy1)+(shr[dy1;1])-32768
ax1:clamp[shr[fx1;16];0;sw1-2]
ay1:clamp[shr[fy1;16];0;sh1-2]
wx1:clamp[and[shr[fx1;8];255]*(fx1>0-1);0;255]
wy1:clamp[and[shr[fy1;8];255]*(fy1>0-1);0;255]
y001:and[tex[Y1;ax1;ay1];255]
y101:and[tex[Y1;ax1+1;ay1];255]
y011:and[tex[Y1;ax1;ay1+1];255]
y111:and[tex[Y1;ax1+1;ay1+1];255]
ly1:shr[(y001*(256-wx1)*(256-wy1))+(y101*wx1*(256-wy1))+(y011*(256-wx1)*wy1)+(y111*wx1*wy1)+32768;16]
gx1:(shr[fx1+32768;1])-32768
gy1:(shr[fy1+32768;1])-32768
qx1:clamp[shr[gx1;16];0;(sw1%2)-2]
qy1:clamp[shr[gy1;16];0;(sh1%2)-2]
vx1:clamp[and[shr[gx1;8];255]*(gx1>0-1);0;255]
vy1:clamp[and[shr[gy1;8];255]*(gy1>0-1);0;255]
u001:and[tex[U1;qx1;qy1];255]
u101:and[tex[U1;qx1+1;qy1];255]
u011:and[tex[U1;qx1;qy1+1];255]
u111:and[tex[U1;qx1+1;qy1+1];255]
v001:and[shr[tex[U1;qx1;qy1];8];255]
v101:and[shr[tex[U1;qx1+1;qy1];8];255]
v011:and[shr[tex[U1;qx1;qy1+1];8];255]
v111:and[shr[tex[U1;qx1+1;qy1+1];8];255]
cu1:(shr[(u001*(256-vx1)*(256-vy1))+(u101*vx1*(256-vy1))+(u011*(256-vx1)*vy1)+(u111*vx1*vy1)+32768;16])-128
cv1:(shr[(v001*(256-vx1)*(256-vy1))+(v101*vx1*(256-vy1))+(v011*(256-vx1)*vy1)+(v111*vx1*vy1)+32768;16])-128
k1:298*ly1-16
rr1:clamp[shr[k1+(459*cv1)+128;8];0;255]
gg1:clamp[shr[k1-(55*cu1)+(136*cv1)-128;8];0;255]
bb1:clamp[shr[k1+(541*cu1)+128;8];0;255]
r:shr[(am1*rr1)+((256-am1)*r);8]
g:shr[(am1*gg1)+((256-am1)*g);8]
b:shr[(am1*bb1)+((256-am1)*b);8]
end
/ clip slot 2
on2:word[C;24]
bx2:word[C;25]
by2:word[C;26]
ex2:word[C;27]
ey2:word[C;28]
sw2:word[C;29]
sh2:word[C;30]
cx2:word[C;31]
cy2:word[C;32]
dx2:word[C;33]
dy2:word[C;34]
al2:word[C;35]
in2:on2*(x>bx2-1)*(x<ex2)*(y>by2-1)*(y<ey2)
ms2:on2>1
cov2:(ms2*and[shr[word[M;i];16];255])+((1-ms2)*255)
am2:((al2*cov2)+127)%255
when in2
fx2:cx2+((x-bx2)*dx2)+(shr[dx2;1])-32768
fy2:cy2+((y-by2)*dy2)+(shr[dy2;1])-32768
ax2:clamp[shr[fx2;16];0;sw2-2]
ay2:clamp[shr[fy2;16];0;sh2-2]
wx2:clamp[and[shr[fx2;8];255]*(fx2>0-1);0;255]
wy2:clamp[and[shr[fy2;8];255]*(fy2>0-1);0;255]
y002:and[tex[Y2;ax2;ay2];255]
y102:and[tex[Y2;ax2+1;ay2];255]
y012:and[tex[Y2;ax2;ay2+1];255]
y112:and[tex[Y2;ax2+1;ay2+1];255]
ly2:shr[(y002*(256-wx2)*(256-wy2))+(y102*wx2*(256-wy2))+(y012*(256-wx2)*wy2)+(y112*wx2*wy2)+32768;16]
gx2:(shr[fx2+32768;1])-32768
gy2:(shr[fy2+32768;1])-32768
qx2:clamp[shr[gx2;16];0;(sw2%2)-2]
qy2:clamp[shr[gy2;16];0;(sh2%2)-2]
vx2:clamp[and[shr[gx2;8];255]*(gx2>0-1);0;255]
vy2:clamp[and[shr[gy2;8];255]*(gy2>0-1);0;255]
u002:and[tex[U2;qx2;qy2];255]
u102:and[tex[U2;qx2+1;qy2];255]
u012:and[tex[U2;qx2;qy2+1];255]
u112:and[tex[U2;qx2+1;qy2+1];255]
v002:and[shr[tex[U2;qx2;qy2];8];255]
v102:and[shr[tex[U2;qx2+1;qy2];8];255]
v012:and[shr[tex[U2;qx2;qy2+1];8];255]
v112:and[shr[tex[U2;qx2+1;qy2+1];8];255]
cu2:(shr[(u002*(256-vx2)*(256-vy2))+(u102*vx2*(256-vy2))+(u012*(256-vx2)*vy2)+(u112*vx2*vy2)+32768;16])-128
cv2:(shr[(v002*(256-vx2)*(256-vy2))+(v102*vx2*(256-vy2))+(v012*(256-vx2)*vy2)+(v112*vx2*vy2)+32768;16])-128
k2:298*ly2-16
rr2:clamp[shr[k2+(459*cv2)+128;8];0;255]
gg2:clamp[shr[k2-(55*cu2)+(136*cv2)-128;8];0;255]
bb2:clamp[shr[k2+(541*cu2)+128;8];0;255]
r:shr[(am2*rr2)+((256-am2)*r);8]
g:shr[(am2*gg2)+((256-am2)*g);8]
b:shr[(am2*bb2)+((256-am2)*b);8]
end
/ clip slot 3
on3:word[C;36]
bx3:word[C;37]
by3:word[C;38]
ex3:word[C;39]
ey3:word[C;40]
sw3:word[C;41]
sh3:word[C;42]
cx3:word[C;43]
cy3:word[C;44]
dx3:word[C;45]
dy3:word[C;46]
al3:word[C;47]
in3:on3*(x>bx3-1)*(x<ex3)*(y>by3-1)*(y<ey3)
ms3:on3>1
cov3:(ms3*and[shr[word[M;i];24];255])+((1-ms3)*255)
am3:((al3*cov3)+127)%255
when in3
fx3:cx3+((x-bx3)*dx3)+(shr[dx3;1])-32768
fy3:cy3+((y-by3)*dy3)+(shr[dy3;1])-32768
ax3:clamp[shr[fx3;16];0;sw3-2]
ay3:clamp[shr[fy3;16];0;sh3-2]
wx3:clamp[and[shr[fx3;8];255]*(fx3>0-1);0;255]
wy3:clamp[and[shr[fy3;8];255]*(fy3>0-1);0;255]
y003:and[tex[Y3;ax3;ay3];255]
y103:and[tex[Y3;ax3+1;ay3];255]
y013:and[tex[Y3;ax3;ay3+1];255]
y113:and[tex[Y3;ax3+1;ay3+1];255]
ly3:shr[(y003*(256-wx3)*(256-wy3))+(y103*wx3*(256-wy3))+(y013*(256-wx3)*wy3)+(y113*wx3*wy3)+32768;16]
gx3:(shr[fx3+32768;1])-32768
gy3:(shr[fy3+32768;1])-32768
qx3:clamp[shr[gx3;16];0;(sw3%2)-2]
qy3:clamp[shr[gy3;16];0;(sh3%2)-2]
vx3:clamp[and[shr[gx3;8];255]*(gx3>0-1);0;255]
vy3:clamp[and[shr[gy3;8];255]*(gy3>0-1);0;255]
u003:and[tex[U3;qx3;qy3];255]
u103:and[tex[U3;qx3+1;qy3];255]
u013:and[tex[U3;qx3;qy3+1];255]
u113:and[tex[U3;qx3+1;qy3+1];255]
v003:and[shr[tex[U3;qx3;qy3];8];255]
v103:and[shr[tex[U3;qx3+1;qy3];8];255]
v013:and[shr[tex[U3;qx3;qy3+1];8];255]
v113:and[shr[tex[U3;qx3+1;qy3+1];8];255]
cu3:(shr[(u003*(256-vx3)*(256-vy3))+(u103*vx3*(256-vy3))+(u013*(256-vx3)*vy3)+(u113*vx3*vy3)+32768;16])-128
cv3:(shr[(v003*(256-vx3)*(256-vy3))+(v103*vx3*(256-vy3))+(v013*(256-vx3)*vy3)+(v113*vx3*vy3)+32768;16])-128
k3:298*ly3-16
rr3:clamp[shr[k3+(459*cv3)+128;8];0;255]
gg3:clamp[shr[k3-(55*cu3)+(136*cv3)-128;8];0;255]
bb3:clamp[shr[k3+(541*cu3)+128;8];0;255]
r:shr[(am3*rr3)+((256-am3)*r);8]
g:shr[(am3*gg3)+((256-am3)*g);8]
b:shr[(am3*bb3)+((256-am3)*b);8]
end
/ the overlay, premultiplied: o + below * (255 - a) / 255
o:word[O;i]
oa:and[shr[o;24];255]
r:and[o;255]+((r*(255-oa))+127)%255
g:and[shr[o;8];255]+((g*(255-oa))+127)%255
b:and[shr[o;16];255]+((b*(255-oa))+127)%255
px:pack[r;g;b;255]
