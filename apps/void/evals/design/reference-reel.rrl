-- CJ: '2 percent of creative'. Generated by gen.py; 1014 frames (33.8 s)
edit {fps: 30, width: 1080, height: 1920, frames: 1014}
camera cam {bg: #000000}
use "media/cj.mov" as take

-- the take, one clip per kept line; punch-ins alternate, pan_y -1 drops her face under a data card
clip a1 {src: take, src_in: 0.0, from: 0, to: 52, zoom: 1.12, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
a1.zoom {0: 1.12, 52: 1.15} linear
clip a2 {src: take, src_in: 1.72, from: 52, to: 89, zoom: 1.2, pan_y: 0.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
a2.zoom {52: 1.2, 89: 1.23} linear
clip b {src: take, src_in: 3.56, from: 89, to: 193, zoom: 1.22, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
b.zoom {89: 1.22, 193: 1.26} linear
clip c {src: take, src_in: 9.3, from: 193, to: 251, zoom: 1.0, pan_y: 0.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
c.zoom {193: 1.0, 251: 1.04} linear
clip d {src: take, src_in: 30.56, from: 251, to: 390, zoom: 1.29, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
d.zoom {251: 1.29, 390: 1.32} linear
clip e {src: take, src_in: 35.18, from: 390, to: 485, zoom: 1.34, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
e.zoom {390: 1.34, 485: 1.37} linear
clip f {src: take, src_in: 41.66, from: 485, to: 564, zoom: 1.0, pan_y: 0.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
f.zoom {485: 1.0, 564: 1.04} linear
clip g {src: take, src_in: 44.3, from: 564, to: 610, zoom: 1.22, pan_y: 0.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
g.zoom {564: 1.22, 610: 1.25} linear
clip h {src: take, src_in: 51.42, from: 610, to: 764, zoom: 1.24, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
h.zoom {610: 1.24, 764: 1.28} linear
clip i {src: take, src_in: 61.66, from: 764, to: 860, zoom: 1.27, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
i.zoom {764: 1.27, 860: 1.33} linear
clip j {src: take, src_in: 70.17, from: 860, to: 1014, zoom: 1.18, pan_y: -1.0, gain: 0, fade_in: 0.012, fade_out: 0.012}
j.zoom {860: 1.18, 1014: 1.23} linear
-- a scrim over the ceiling so white type holds against the cream wall
box scrim {x: 0, y: 0, w: 1080, h: 1000, bg: "linear-gradient(180deg, rgba(20,16,12,0.55) 0%, rgba(20,16,12,0.35) 45%, rgba(20,16,12,0) 100%)", from: 0, to: 1014}

-- captions: Avenir Next Heavy caps, 1-3 words, the spoken word lit lime (karaoke rule below), key words stay lit
style cap {font: "Avenir Next Condensed", weight: 800, size: 96, color: #ffffff, x: 70, w: 940, y: 260, align: "center", line: 0.95, case: "uppercase", tracking: -2, text_shadow: "0 3px 0 rgba(0,0,0,0.30), 0 0 2px rgba(0,0,0,0.6), 0 8px 26px rgba(0,0,0,0.55)"}
title g0 {style: cap, size: 136, text: "", from: 486, to: 539}
g0.scale {486: 0.8, 489: 1.06, 492: 1.0} ease out
g0.y {486: 286, 491: 260} ease out
text g0w0 in g0 {text: "the ", ws: 486, we: 491, class: "w", from: 486, to: 539}
text g0w1 in g0 {text: "answer ", ws: 491, we: 503, class: "w", from: 486, to: 539}
text g0w2 in g0 {text: "is ", ws: 503, we: 510, class: "w", from: 486, to: 539}
text g0w3 in g0 {text: "not ", ws: 510, we: 515, class: "k", from: 486, to: 539}
text g0w4 in g0 {text: "just", ws: 515, we: 539, class: "w", from: 486, to: 539}
title g1 {style: cap, size: 122, text: "", from: 539, to: 564}
g1.scale {539: 0.8, 542: 1.06, 545: 1.0} ease out
g1.y {539: 286, 544: 260} ease out
text g1w0 in g1 {text: "make ", ws: 539, we: 546, class: "k", from: 539, to: 564}
text g1w1 in g1 {text: "more ", ws: 546, we: 551, class: "k", from: 539, to: 564}
text g1w2 in g1 {text: "ads.", ws: 551, we: 564, class: "k", from: 539, to: 564}
title g2 {style: cap, size: 112, text: "", from: 565, to: 610}
g2.scale {565: 0.8, 568: 1.06, 571: 1.0} ease out
g2.y {565: 286, 570: 260} ease out
text g2w0 in g2 {text: "You ", ws: 565, we: 570, class: "w", from: 565, to: 610}
text g2w1 in g2 {text: "need ", ws: 570, we: 575, class: "w", from: 565, to: 610}
text g2w2 in g2 {text: "more ", ws: 575, we: 582, class: "k", from: 565, to: 610}
text g2w3 in g2 {text: "meaningful ", ws: 582, we: 594, class: "k", from: 565, to: 610}
text g2w4 in g2 {text: "bets.", ws: 594, we: 610, class: "k", from: 565, to: 610}
karaoke: W.color = #c8ff2e if text W {class: "w"}, frame >= W.ws, frame < W.we
key-lit: W.color = #c8ff2e if text W {class: "k"}, frame >= W.ws
key-red: W.color = #ff4d3d if text W {class: "r"}, frame >= W.ws

