hwant.y {52: 280, 58: 250} ease out
title hback {text: "strategy back.", font: "Avenir Next Condensed", weight: 800, size: 118, color: #c8ff2e, x: 90, w: 900, y: 370, align: "center", line: 0.92, case: "uppercase", tracking: -2, from: 56, to: 89, text_shadow: "0 3px 0 rgba(0,0,0,0.35), 0 0 3px rgba(0,0,0,0.5), 0 10px 36px rgba(0,0,0,0.55)"}
