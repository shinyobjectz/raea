/ The whole edit at proxy size (pw x ph) in one dispatch: thread i is pixel p of frame fi. Planes are packed in
/ PP (NV12 bytes), overlays in OO (premultiplied RGBA words); frame fi's parameters are words fi*53.. of Q.
np:pw*ph
fi:i%np
p:i!np
x:p!pw
y:p%pw
q:fi*53
r:and[bgc;255]
g:and[shr[bgc;8];255]
b:and[shr[bgc;16];255]
on0:word[Q;q+0]
bx0:word[Q;q+1]
by0:word[Q;q+2]
ex0:word[Q;q+3]
ey0:word[Q;q+4]
in0:on0*(x>bx0-1)*(x<ex0)*(y>by0-1)*(y<ey0)
when in0
sw0:word[Q;q+5]
sh0:word[Q;q+6]
cx0:word[Q;q+7]
cy0:word[Q;q+8]
dx0:word[Q;q+9]
dy0:word[Q;q+10]
al0:word[Q;q+11]
po0:word[Q;q+12]
fx0:cx0+((x-bx0)*dx0)+(shr[dx0;1])-32768
fy0:cy0+((y-by0)*dy0)+(shr[dy0;1])-32768
ax0:clamp[shr[fx0;16];0;sw0-2]
ay0:clamp[shr[fy0;16];0;sh0-2]
wx0:clamp[and[shr[fx0;8];255]*(fx0>0-1);0;255]
wy0:clamp[and[shr[fy0;8];255]*(fy0>0-1);0;255]
y000:byte[PP;po0+(ay0*sw0)+ax0]
y100:byte[PP;po0+(ay0*sw0)+ax0+1]
y010:byte[PP;po0+((ay0+1)*sw0)+ax0]
y110:byte[PP;po0+((ay0+1)*sw0)+ax0+1]
ly0:shr[(y000*(256-wx0)*(256-wy0))+(y100*wx0*(256-wy0))+(y010*(256-wx0)*wy0)+(y110*wx0*wy0)+32768;16]
gx0:(shr[fx0+32768;1])-32768
gy0:(shr[fy0+32768;1])-32768
qx0:clamp[shr[gx0;16];0;(sw0%2)-2]
qy0:clamp[shr[gy0;16];0;(sh0%2)-2]
vx0:clamp[and[shr[gx0;8];255]*(gx0>0-1);0;255]
vy0:clamp[and[shr[gy0;8];255]*(gy0>0-1);0;255]
ci0:po0+(sw0*sh0)+(qy0*sw0)+2*qx0
u000:byte[PP;ci0]
u100:byte[PP;ci0+2]
u010:byte[PP;ci0+sw0]
u110:byte[PP;ci0+sw0+2]
v000:byte[PP;ci0+1]
v100:byte[PP;ci0+3]
v010:byte[PP;ci0+sw0+1]
v110:byte[PP;ci0+sw0+3]
cu0:(shr[(u000*(256-vx0)*(256-vy0))+(u100*vx0*(256-vy0))+(u010*(256-vx0)*vy0)+(u110*vx0*vy0)+32768;16])-128
cv0:(shr[(v000*(256-vx0)*(256-vy0))+(v100*vx0*(256-vy0))+(v010*(256-vx0)*vy0)+(v110*vx0*vy0)+32768;16])-128
k0:298*ly0-16
r:shr[(al0*clamp[shr[k0+(459*cv0)+128;8];0;255])+((256-al0)*r);8]
g:shr[(al0*clamp[shr[k0-(55*cu0)+(136*cv0)-128;8];0;255])+((256-al0)*g);8]
b:shr[(al0*clamp[shr[k0+(541*cu0)+128;8];0;255])+((256-al0)*b);8]
end
on1:word[Q;q+13]
bx1:word[Q;q+14]
by1:word[Q;q+15]
ex1:word[Q;q+16]
ey1:word[Q;q+17]
in1:on1*(x>bx1-1)*(x<ex1)*(y>by1-1)*(y<ey1)
when in1
sw1:word[Q;q+18]
sh1:word[Q;q+19]
cx1:word[Q;q+20]
cy1:word[Q;q+21]
dx1:word[Q;q+22]
dy1:word[Q;q+23]
al1:word[Q;q+24]
po1:word[Q;q+25]
fx1:cx1+((x-bx1)*dx1)+(shr[dx1;1])-32768
fy1:cy1+((y-by1)*dy1)+(shr[dy1;1])-32768
ax1:clamp[shr[fx1;16];0;sw1-2]
ay1:clamp[shr[fy1;16];0;sh1-2]
wx1:clamp[and[shr[fx1;8];255]*(fx1>0-1);0;255]
wy1:clamp[and[shr[fy1;8];255]*(fy1>0-1);0;255]
y001:byte[PP;po1+(ay1*sw1)+ax1]
y101:byte[PP;po1+(ay1*sw1)+ax1+1]
y011:byte[PP;po1+((ay1+1)*sw1)+ax1]
y111:byte[PP;po1+((ay1+1)*sw1)+ax1+1]
ly1:shr[(y001*(256-wx1)*(256-wy1))+(y101*wx1*(256-wy1))+(y011*(256-wx1)*wy1)+(y111*wx1*wy1)+32768;16]
gx1:(shr[fx1+32768;1])-32768
gy1:(shr[fy1+32768;1])-32768
qx1:clamp[shr[gx1;16];0;(sw1%2)-2]
qy1:clamp[shr[gy1;16];0;(sh1%2)-2]
vx1:clamp[and[shr[gx1;8];255]*(gx1>0-1);0;255]
vy1:clamp[and[shr[gy1;8];255]*(gy1>0-1);0;255]
ci1:po1+(sw1*sh1)+(qy1*sw1)+2*qx1
u001:byte[PP;ci1]
u101:byte[PP;ci1+2]
u011:byte[PP;ci1+sw1]
u111:byte[PP;ci1+sw1+2]
v001:byte[PP;ci1+1]
v101:byte[PP;ci1+3]
v011:byte[PP;ci1+sw1+1]
v111:byte[PP;ci1+sw1+3]
cu1:(shr[(u001*(256-vx1)*(256-vy1))+(u101*vx1*(256-vy1))+(u011*(256-vx1)*vy1)+(u111*vx1*vy1)+32768;16])-128
cv1:(shr[(v001*(256-vx1)*(256-vy1))+(v101*vx1*(256-vy1))+(v011*(256-vx1)*vy1)+(v111*vx1*vy1)+32768;16])-128
k1:298*ly1-16
r:shr[(al1*clamp[shr[k1+(459*cv1)+128;8];0;255])+((256-al1)*r);8]
g:shr[(al1*clamp[shr[k1-(55*cu1)+(136*cv1)-128;8];0;255])+((256-al1)*g);8]
b:shr[(al1*clamp[shr[k1+(541*cu1)+128;8];0;255])+((256-al1)*b);8]
end
on2:word[Q;q+26]
bx2:word[Q;q+27]
by2:word[Q;q+28]
ex2:word[Q;q+29]
ey2:word[Q;q+30]
in2:on2*(x>bx2-1)*(x<ex2)*(y>by2-1)*(y<ey2)
when in2
sw2:word[Q;q+31]
sh2:word[Q;q+32]
cx2:word[Q;q+33]
cy2:word[Q;q+34]
dx2:word[Q;q+35]
dy2:word[Q;q+36]
al2:word[Q;q+37]
po2:word[Q;q+38]
fx2:cx2+((x-bx2)*dx2)+(shr[dx2;1])-32768
fy2:cy2+((y-by2)*dy2)+(shr[dy2;1])-32768
ax2:clamp[shr[fx2;16];0;sw2-2]
ay2:clamp[shr[fy2;16];0;sh2-2]
wx2:clamp[and[shr[fx2;8];255]*(fx2>0-1);0;255]
wy2:clamp[and[shr[fy2;8];255]*(fy2>0-1);0;255]
y002:byte[PP;po2+(ay2*sw2)+ax2]
y102:byte[PP;po2+(ay2*sw2)+ax2+1]
y012:byte[PP;po2+((ay2+1)*sw2)+ax2]
y112:byte[PP;po2+((ay2+1)*sw2)+ax2+1]
ly2:shr[(y002*(256-wx2)*(256-wy2))+(y102*wx2*(256-wy2))+(y012*(256-wx2)*wy2)+(y112*wx2*wy2)+32768;16]
gx2:(shr[fx2+32768;1])-32768
gy2:(shr[fy2+32768;1])-32768
qx2:clamp[shr[gx2;16];0;(sw2%2)-2]
qy2:clamp[shr[gy2;16];0;(sh2%2)-2]
vx2:clamp[and[shr[gx2;8];255]*(gx2>0-1);0;255]
vy2:clamp[and[shr[gy2;8];255]*(gy2>0-1);0;255]
ci2:po2+(sw2*sh2)+(qy2*sw2)+2*qx2
u002:byte[PP;ci2]
u102:byte[PP;ci2+2]
u012:byte[PP;ci2+sw2]
u112:byte[PP;ci2+sw2+2]
v002:byte[PP;ci2+1]
v102:byte[PP;ci2+3]
v012:byte[PP;ci2+sw2+1]
v112:byte[PP;ci2+sw2+3]
cu2:(shr[(u002*(256-vx2)*(256-vy2))+(u102*vx2*(256-vy2))+(u012*(256-vx2)*vy2)+(u112*vx2*vy2)+32768;16])-128
cv2:(shr[(v002*(256-vx2)*(256-vy2))+(v102*vx2*(256-vy2))+(v012*(256-vx2)*vy2)+(v112*vx2*vy2)+32768;16])-128
k2:298*ly2-16
r:shr[(al2*clamp[shr[k2+(459*cv2)+128;8];0;255])+((256-al2)*r);8]
g:shr[(al2*clamp[shr[k2-(55*cu2)+(136*cv2)-128;8];0;255])+((256-al2)*g);8]
b:shr[(al2*clamp[shr[k2+(541*cu2)+128;8];0;255])+((256-al2)*b);8]
end
on3:word[Q;q+39]
bx3:word[Q;q+40]
by3:word[Q;q+41]
ex3:word[Q;q+42]
ey3:word[Q;q+43]
in3:on3*(x>bx3-1)*(x<ex3)*(y>by3-1)*(y<ey3)
when in3
sw3:word[Q;q+44]
sh3:word[Q;q+45]
cx3:word[Q;q+46]
cy3:word[Q;q+47]
dx3:word[Q;q+48]
dy3:word[Q;q+49]
al3:word[Q;q+50]
po3:word[Q;q+51]
fx3:cx3+((x-bx3)*dx3)+(shr[dx3;1])-32768
fy3:cy3+((y-by3)*dy3)+(shr[dy3;1])-32768
ax3:clamp[shr[fx3;16];0;sw3-2]
ay3:clamp[shr[fy3;16];0;sh3-2]
wx3:clamp[and[shr[fx3;8];255]*(fx3>0-1);0;255]
wy3:clamp[and[shr[fy3;8];255]*(fy3>0-1);0;255]
y003:byte[PP;po3+(ay3*sw3)+ax3]
y103:byte[PP;po3+(ay3*sw3)+ax3+1]
y013:byte[PP;po3+((ay3+1)*sw3)+ax3]
y113:byte[PP;po3+((ay3+1)*sw3)+ax3+1]
ly3:shr[(y003*(256-wx3)*(256-wy3))+(y103*wx3*(256-wy3))+(y013*(256-wx3)*wy3)+(y113*wx3*wy3)+32768;16]
gx3:(shr[fx3+32768;1])-32768
gy3:(shr[fy3+32768;1])-32768
qx3:clamp[shr[gx3;16];0;(sw3%2)-2]
qy3:clamp[shr[gy3;16];0;(sh3%2)-2]
vx3:clamp[and[shr[gx3;8];255]*(gx3>0-1);0;255]
vy3:clamp[and[shr[gy3;8];255]*(gy3>0-1);0;255]
ci3:po3+(sw3*sh3)+(qy3*sw3)+2*qx3
u003:byte[PP;ci3]
u103:byte[PP;ci3+2]
u013:byte[PP;ci3+sw3]
u113:byte[PP;ci3+sw3+2]
v003:byte[PP;ci3+1]
v103:byte[PP;ci3+3]
v013:byte[PP;ci3+sw3+1]
v113:byte[PP;ci3+sw3+3]
cu3:(shr[(u003*(256-vx3)*(256-vy3))+(u103*vx3*(256-vy3))+(u013*(256-vx3)*vy3)+(u113*vx3*vy3)+32768;16])-128
cv3:(shr[(v003*(256-vx3)*(256-vy3))+(v103*vx3*(256-vy3))+(v013*(256-vx3)*vy3)+(v113*vx3*vy3)+32768;16])-128
k3:298*ly3-16
r:shr[(al3*clamp[shr[k3+(459*cv3)+128;8];0;255])+((256-al3)*r);8]
g:shr[(al3*clamp[shr[k3-(55*cu3)+(136*cv3)-128;8];0;255])+((256-al3)*g);8]
b:shr[(al3*clamp[shr[k3+(541*cu3)+128;8];0;255])+((256-al3)*b);8]
end
oo:word[Q;q+52]
when oo>0-1
o:word[OO;oo+p]
oa:and[shr[o;24];255]
r:and[o;255]+((r*(255-oa))+127)%255
g:and[shr[o;8];255]+((g*(255-oa))+127)%255
b:and[shr[o;16];255]+((b*(255-oa))+127)%255
end
px:pack[r;g;b;255]
